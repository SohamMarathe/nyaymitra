# Copy this file to .env and fill in your own values.
# .env is git-ignored — your real key never gets pushed to GitHub.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model tiering — defaults shown below are what config.py falls back to if unset
MODEL_FAST=gemini-3.1-flash-lite
MODEL_REASONING=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Database — default assumes PostgreSQL via Docker (see SETUP.md step 4).
# To skip Docker, use SQLite instead (see SETUP.md step 3.5):
# DATABASE_URL=sqlite:///./nyayamitra.db
DATABASE_URL=postgresql+psycopg://nyayamitra:nyayamitra@localhost:5432/nyayamitra

# Retrieval tuning
TOP_K_CHUNKS=6
RETRIEVAL_DISTANCE_THRESHOLD=0.9
RETRIEVAL_DISTANCE_GOOD=0.9

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
